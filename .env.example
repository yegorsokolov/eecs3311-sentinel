# Copy this file to .env in the project root, then set any overrides you need.
# Every supported environment override is listed below. Blank values use defaults.
# Process environment variables take precedence over .env.

# Ollama base URL. Default: http://localhost:11434
SENTINEL_OLLAMA_URL=
# Installed Ollama model tag. Default: qwen2.5:7b
SENTINEL_OLLAMA_MODEL=

# Storage directories, relative to the project working directory or absolute.
# Default: runtime/datasets
SENTINEL_DATA_DIR=
# Default: runtime/cases
SENTINEL_CASE_DIR=
# Default: runtime/exports
SENTINEL_EXPORT_DIR=

# Local Ollama needs no API key. Start Ollama and install the selected model
# when runtime integration is available. Copying this file does not install services.
# Stage 1 execution budgets are bundled settings, not environment overrides.
# ToolExecutor enforces tool limits; model/plan orchestration remains pending.
