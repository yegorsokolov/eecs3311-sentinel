# Optional overrides. Copy to .env only if it does not already exist.
# Process environment > .env > bundled defaults. Blank values retain defaults.
# Full setup and provider switching: docs/model-setup.md.

# Canonical provider settings (default: local Ollama, no key required).
SENTINEL_LLM_PROVIDER=
SENTINEL_LLM_BASE_URL=
SENTINEL_LLM_MODEL=
SENTINEL_LLM_API_KEY=
SENTINEL_LLM_JSON_MODE=
SENTINEL_LLM_TOKEN_FIELD=

# Legacy aliases: http://localhost:11434 and qwen2.5:7b by default.
# Canonical settings win ties at the same precedence level.
SENTINEL_OLLAMA_URL=
SENTINEL_OLLAMA_MODEL=

# Storage directories, relative to project root or absolute.
SENTINEL_DATA_DIR=
SENTINEL_CASE_DIR=
SENTINEL_EXPORT_DIR=

# Never commit .env or real keys. Local Ollama does not issue or need an API key.
# Stage 1 execution budgets remain bounded bundled settings.
