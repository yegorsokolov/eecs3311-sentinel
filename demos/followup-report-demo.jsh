import sentinel.analysis.*;
import sentinel.application.*;
import sentinel.data.*;
import sentinel.domain.*;
import sentinel.events.*;
import sentinel.llm.*;
import sentinel.persistence.*;
import sentinel.tools.*;
import java.nio.file.*;
import java.time.*;
import java.util.*;
import java.util.concurrent.atomic.*;
var time = Instant.parse("2026-10-22T12:00:00Z");
var store = new DatasetStore("orchestration-demo",Clock.fixed(time.plusSeconds(7*86400),ZoneOffset.UTC),Duration.ofDays(30));
var rows = new ArrayList<Event>();
for (int n=0; n<5; n++) rows.add(new Event("failure-"+n,time.plusSeconds(n),"login","demo-analyst","192.0.2.10","demo-host","failure","synthetic#/"+n,"pending"));
rows.add(new Event("success",time.plusSeconds(5),"login","demo-analyst","192.0.2.10","demo-host","success","synthetic#/5","pending"));
store.ingest(new ImportBatch(rows));
store.loadIndicatorFeed(Path.of("data/indicators/threat-feed.json"));
var scope = new CaseScope(store.datasetId(),store.currentVersion(),"demo-analyst",time,time.plusSeconds(600));
var investigation = new Investigation(new Request("Investigate synthetic logins",scope),TargetType.ACCOUNT,"demo-feed-v1");
var calls = new AtomicInteger();
LLMGateway fixture = prompt -> { calls.incrementAndGet(); if(prompt.purpose().equals("answer"))return "{\"text\":\"Review the cited login.\",\"evidenceIds\":[\"E1\"],\"limitations\":[\"Synthetic evidence only\"]}"; return JsonCodec.encode(new AnalysisService.ShortSynthesis("analysis-v1",new AnalysisService.ShortHypothesis("Possible suspicious sequence","E1",List.of(),"LOW","Correlation is not proof"),new AnalysisService.ShortRecommendation("REVIEW","Review cited login","E1","HIGH","Analyst approval"))); };
var tools = ToolExecutor.local(store);
var bus = new EventBus();
bus.subscribe(e -> System.out.println("Progress: "+e.stage()+" / "+e.outcome()));
var analysis = new AnalysisService(fixture,new TimelineBuilder(),new RuleSeverityPolicy(),store);
var engine = new AgentEngine(context -> null,tools,analysis,bus,store);
engine.acceptRulePlan(investigation);
var assessment = engine.run(investigation);
if (investigation.snapshot().status()!=CaseStatus.COMPLETED || assessment.severity().score()!=7 || investigation.snapshot().plan().revision()!=1 || calls.get()!=1) throw new AssertionError("Bounded run failed");
System.out.println("FAKE GATEWAY: no real model inference performed.");
System.out.println("Run: "+investigation.snapshot().status()+" / score="+assessment.severity().score()+" / timeline="+assessment.timeline().size()+" / evidence="+investigation.snapshot().evidence().size()+" / plan revision="+investigation.snapshot().plan().revision()+" / model calls="+calls.get());
var parent = Files.createDirectories(Path.of("runtime/persistence-demo"));
var folder = Files.createTempDirectory(parent,"take-");
var datasetFile = folder.resolve("dataset.json");
store.save(datasetFile);
var restored = new DatasetStore(store.datasetId());
restored.restore(datasetFile);
if (!restored.events("v1").equals(store.events("v1"))) throw new AssertionError("Dataset history changed");
var repository = new JsonCaseRepository(folder.resolve("cases"));
repository.save(investigation.snapshot());
var reopened = repository.load(investigation.snapshot().id());
if (!reopened.snapshot().equals(investigation.snapshot())) throw new AssertionError("Case roundtrip changed");
for (var evidence : reopened.snapshot().evidence()) if (restored.resolveEvent(evidence).isEmpty() && restored.resolveIndicator(evidence).isEmpty()) throw new AssertionError("Lost canonical provenance");
var answer = engine.ask(reopened,"What supports the assessment?");
if (answer.evidenceIds().isEmpty() || reopened.snapshot().conversation().size()!=1) throw new AssertionError("Follow-up citation/conversation failed");
repository.save(reopened.snapshot());
var afterAnswer = repository.load(reopened.snapshot().id());
if (!afterAnswer.snapshot().conversation().get(0).answer().equals(answer)) throw new AssertionError("Conversation persistence failed");
var reporter = new sentinel.reporting.ReportService();
int beforeExport = calls.get();
var reportFile = folder.resolve("case-report.md");
reporter.export(afterAnswer,reportFile);
if (!Files.readString(reportFile).equals(reporter.preview(afterAnswer.snapshot())) || calls.get()!=beforeExport) throw new AssertionError("Export changed state or called model");
try {reporter.export(afterAnswer,reportFile);throw new AssertionError("Silent overwrite");} catch (IllegalStateException expected) {System.out.println("Existing Markdown export preserved without overwrite approval.");}
System.out.println("Follow-up: cited answer accepted and conversation reopened.");
System.out.println("Deterministic runtime Markdown export: "+reportFile.toAbsolutePath());
System.out.println("This case report is distinct from the assignment Word report.");
tools.close();
/exit
