import sentinel.analysis.*;
import sentinel.application.*;
import sentinel.data.*;
import sentinel.domain.*;
import sentinel.events.*;
import sentinel.llm.*;
import sentinel.persistence.*;
import sentinel.tools.*;
import java.nio.file.*;
import java.time.*;
import java.util.*;
import java.util.concurrent.atomic.*;
var time = Instant.parse("2026-10-22T12:00:00Z");
var store = new DatasetStore("orchestration-demo",Clock.fixed(time.plusSeconds(7*86400),ZoneOffset.UTC),Duration.ofDays(30));
var rows = new ArrayList<Event>();
for (int n=0; n<5; n++) rows.add(new Event("failure-"+n,time.plusSeconds(n),"login","demo-analyst","192.0.2.10","demo-host","failure","synthetic#/"+n,"pending"));
rows.add(new Event("success",time.plusSeconds(5),"login","demo-analyst","192.0.2.10","demo-host","success","synthetic#/5","pending"));
store.ingest(new ImportBatch(rows));
store.loadIndicatorFeed(Path.of("data/indicators/threat-feed.json"));
var scope = new CaseScope(store.datasetId(),store.currentVersion(),"demo-analyst",time,time.plusSeconds(600));
var investigation = new Investigation(new Request("Investigate synthetic logins",scope),TargetType.ACCOUNT,"demo-feed-v1");
var calls = new AtomicInteger();
LLMGateway fixture = prompt -> { calls.incrementAndGet(); return JsonCodec.encode(new AnalysisService.ShortSynthesis("analysis-v1",new AnalysisService.ShortHypothesis("Possible suspicious sequence","E1",List.of(),"LOW","Correlation is not proof"),new AnalysisService.ShortRecommendation("REVIEW","Review cited login","E1","HIGH","Analyst approval"))); };
var tools = ToolExecutor.local(store);
var bus = new EventBus();
bus.subscribe(e -> System.out.println("Progress: "+e.stage()+" / "+e.outcome()));
var analysis = new AnalysisService(fixture,new TimelineBuilder(),new RuleSeverityPolicy(),store);
var engine = new AgentEngine(context -> null,tools,analysis,bus,store);
engine.acceptRulePlan(investigation);
var assessment = engine.run(investigation);
if (investigation.snapshot().status()!=CaseStatus.COMPLETED || assessment.severity().score()!=7 || investigation.snapshot().plan().revision()!=1 || calls.get()!=1) throw new AssertionError("Bounded run failed");
System.out.println("FAKE GATEWAY: no real model inference performed.");
System.out.println("Run: "+investigation.snapshot().status()+" / score="+assessment.severity().score()+" / timeline="+assessment.timeline().size()+" / evidence="+investigation.snapshot().evidence().size()+" / plan revision="+investigation.snapshot().plan().revision()+" / model calls="+calls.get());
tools.close();
/exit
