import sentinel.analysis.*;
import sentinel.data.*;
import sentinel.domain.*;
import sentinel.llm.*;
import sentinel.persistence.*;
import java.time.*;
import java.util.*;
import java.util.concurrent.atomic.*;
var time = Instant.parse("2026-10-22T12:00:00Z");
var store = new DatasetStore("analysis-demo");
var rows = new ArrayList<Event>();
for (int n=0; n<5; n++) rows.add(new Event("failure-"+n,time.plusSeconds(n),"login","demo-analyst",null,"demo-host","failure","synthetic#/"+n,"pending"));
rows.add(new Event("success",time.plusSeconds(5),"login","demo-analyst",null,"demo-host","success","synthetic#/5","pending"));
store.ingest(new ImportBatch(rows));
var scope = new CaseScope("analysis-demo",store.currentVersion(),"demo-analyst",time,time.plusSeconds(600));
var investigation = new Investigation(new Request("Investigate synthetic logins",scope));
var args = Map.of("datasetId",scope.datasetId(),"datasetVersion",scope.datasetVersion(),"accountId",scope.target(),"start",scope.start().toString(),"end",scope.end().toString(),"limit","100");
investigation.addEvidence(store.search(new ToolCall(UUID.randomUUID(),"logSearch",args)));
var calls = new AtomicInteger();
LLMGateway fixture = prompt -> JsonCodec.encode(new AnalysisService.ShortSynthesis("analysis-v1",new AnalysisService.ShortHypothesis("Possible suspicious sequence",calls.getAndIncrement()==0?"E99":"E1",List.of(),"LOW","Correlation is not causal proof"),new AnalysisService.ShortRecommendation("REVIEW","Review cited login","E1","HIGH","Analyst approval")));
var analysis = new AnalysisService(fixture,new TimelineBuilder(),new RuleSeverityPolicy(),store);
var budget = new ModelBudget();
var assessment = analysis.analyze(investigation,budget,false);
if (assessment.completeness()!=Completeness.COMPLETE || assessment.severity().score()!=5 || calls.get()!=2 || budget.used()!=2) throw new AssertionError("Analysis/repair failed");
if (!assessment.hypotheses().get(0).supportingEvidenceIds().equals(List.of(investigation.snapshot().evidence().get(0).id()))) throw new AssertionError("Citation did not resolve to canonical evidence");
System.out.println("FAKE GATEWAY: no real model inference performed.");
System.out.println("Repaired synthesis: "+assessment.completeness()+" / fixed severity "+assessment.severity().score()+" "+assessment.severity().level()+" / calls="+budget.used());
System.out.println("Citations resolved to accepted immutable source evidence.");
System.out.println("Recommendation: "+assessment.recommendations().get(0));
/exit
